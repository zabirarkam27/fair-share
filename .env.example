# EXAMPLE PLACEHOLDERS ONLY: these passwords/secrets are not working credentials.
# Copy to .env.local or use db:setup-local. Never use the archived reference DB.
# The application uses only the restricted runtime URL. Keep owner URLs server-side.
DATABASE_URL=postgresql://fairshare_p1_app:replace-runtime-password@127.0.0.1:55432/fairshare_phase1
DIRECT_URL=postgresql://fairshare_p1_owner:replace-owner-password@127.0.0.1:55432/fairshare_phase1
# Separate database for Prisma migrate dev; migrate deploy does not use a shadow.
SHADOW_DATABASE_URL=postgresql://fairshare_p1_owner:replace-owner-password@127.0.0.1:55432/fairshare_shadow
# Tests REQUIRE this separately owned allowlisted database, never dev/demo/prod.
TEST_DATABASE_URL=postgresql://fairshare_p1_test_app:replace-test-runtime-password@127.0.0.1:55432/fairshare_test
TEST_MIGRATION_URL=postgresql://fairshare_p1_test_owner:replace-test-owner-password@127.0.0.1:55432/fairshare_test
# Generate e.g. node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-characters
# Exact trusted origin. Use HTTPS for an actual deployment; no wildcard origins.
BETTER_AUTH_URL=http://127.0.0.1:3000

# Optional safety input: tests/demo seed reject matching development/production DBs.
# PRODUCTION_DATABASE_URL=postgresql://replace-user:replace-password@replace-host/replace-production-database
# Optional local PostgreSQL binaries (otherwise documented platform default/PATH).
# PG_BIN=C:/Program Files/PostgreSQL/18/bin
# No NEXT_PUBLIC_ secrets are required or permitted.
# Demo passwords are generated by db:seed:demo into ignored .local/demo-credentials.json.
