{
  "name": "fairshare",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:integration": "node scripts/migrate.mjs --test && node scripts/test-integration.mjs",
    "test:migrations": "node scripts/test-migrations.mjs",
    "db:setup-local": "node scripts/setup-local.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:test": "node scripts/migrate.mjs --test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "postgres:local": "node scripts/postgres-local.mjs",
    "postgres:stop": "node scripts/postgres-local.mjs --stop"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.16",
    "@hookform/resolvers": "7.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tailwindcss/postcss": "4.3.4",
    "better-auth": "1.7.16",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.9",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "shadcn": "4.23.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
